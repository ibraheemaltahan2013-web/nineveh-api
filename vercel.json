{
  "version": 2,
  "installCommand": "npm install --cache D:/npm-cache",
  "buildCommand": "npm install && npx prisma generate",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
