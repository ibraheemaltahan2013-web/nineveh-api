generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  ASSISTANT
  TEACHER
  STUDENT
  PARENT
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  role          Role     @default(STUDENT)
  gender        Gender?
  phone         String?
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher       Teacher?
  student       Student?
  parent        Parent?
  sentMessages  Message[]    @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  announcements Announcement[] @relation("AnnouncementAuthor")
  assignments   Assignment[] @relation("AssignmentTeacher")
  submissions   Submission[] @relation("SubmissionStudent")
  grades        Grade[]      @relation("GradeTeacher")
  attendances   Attendance[] @relation("AttendanceTeacher")
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String  @unique
  subject   String?
  hireDate  DateTime @default(now())
  classes   Class[]  @relation("ClassTeacher")
}

model Student {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId    String   @unique
  classId      String?
  class        Class?   @relation(fields: [classId], references: [id])
  parentId     String?
  parent       Parent?  @relation(fields: [parentId], references: [id])
  enrollDate   DateTime @default(now())
  submissions  Submission[] @relation("SubmissionStudent")
  grades       Grade[]      @relation("GradeStudent")
  attendances  Attendance[] @relation("AttendanceStudent")
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  students  Student[]
}

model Class {
  id          String   @id @default(cuid())
  name        String
  grade       Int
  section     String
  teacherId   String?
  teacher     Teacher? @relation("ClassTeacher", fields: [teacherId], references: [id])
  students    Student[]
  schedules   Schedule[]
  assignments Assignment[]
  exams       Exam[]
}

model Schedule {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  targetRoles Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User     @relation("AssignmentTeacher", fields: [teacherId], references: [id])
  dueDate     DateTime
  maxScore    Int      @default(100)
  attachments String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  submissions Submission[]
}

model Submission {
  id            String   @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation("SubmissionStudent", fields: [studentId], references: [id])
  content       String?
  attachments   String[]
  status        AssignmentStatus @default(PENDING)
  submittedAt   DateTime?
  gradedAt      DateTime?
  grade         Grade?
}

model Grade {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation("GradeStudent", fields: [studentId], references: [id])
  teacherId   String
  teacher     User     @relation("GradeTeacher", fields: [teacherId], references: [id])
  assignmentId String?
  assignment  Assignment? @relation(fields: [assignmentId], references: [id])
  examId      String?
  exam        Exam?    @relation(fields: [examId], references: [id])
  score       Int
  maxScore    Int
  feedback    String?
  createdAt   DateTime @default(now())
}

model Exam {
  id        String   @id @default(cuid())
  title     String
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String
  examDate  DateTime
  duration  Int
  maxScore  Int      @default(100)
  grades    Grade[]
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation("AttendanceStudent", fields: [studentId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  teacherId String
  teacher   User     @relation("AttendanceTeacher", fields: [teacherId], references: [id])
  date      DateTime @default(now())
  status    AttendanceStatus @default(PRESENT)
  notes     String?

  @@unique([studentId, classId, date])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}